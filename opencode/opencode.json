{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@cortexkit/opencode-anthropic-auth@2.4.2",
    "@mohak34/opencode-notifier@1.1.1",
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.1",
    "opencode-update-notifier",
    "@slkiser/opencode-quota@6.0.0",
    "@cortexkit/opencode-magic-context@0.49.28",
    "opencode-keepalive@git+https://github.com/tim-hilde/opencode-keepalive.git"
  ],
  "experimental": {
    "subagent_depth": 2
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Zettelkasten/_career-log/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/code/Merlin/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ],
  "compaction": {
    "auto": false
  },
  "warming": true,
  "agents": {
    "general": {
      "model": "anthropic/claude-sonnet-5-5"
    },
    "explore": {
      "model": "anthropic/claude-sonnet-5-5"
    }
  },
  "mcp": {
    "servers": {
      "ris": {
        "type": "remote",
        "url": "http://127.0.0.1:8765/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RIS_BEARER}"
        },
        "disabled": true
      },
      "livekit-docs": {
        "type": "remote",
        "url": "https://docs.livekit.io/mcp"
      },
      "langfuse-docs": {
        "type": "remote",
        "url": "https://langfuse.com/api/mcp",
        "disabled": true
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      "open-design": {
        "type": "local",
        "command": [
          "/Applications/Open Design.app/Contents/Frameworks/Open Design Helper.app/Contents/MacOS/Open Design Helper",
          "/Applications/Open Design.app/Contents/Resources/app/prebundled/daemon/daemon-cli.mjs",
          "mcp"
        ],
        "environment": {
          "OD_DATA_DIR": "/Users/tim/Library/Application Support/Open Design/namespaces/release-stable/data",
          "OD_SIDECAR_IPC_PATH": "/tmp/open-design/ipc/release-stable/daemon.sock",
          "ELECTRON_RUN_AS_NODE": "1"
        },
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--viewport",
          "1280x720",
          "--enable-script"
        ],
        "environment": {
          "START_URL": "about:blank"
        },
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "axiom": {
        "type": "remote",
        "url": "https://mcp.axiom.co/mcp",
        "disabled": true
      }
    }
  },
  "providers": {
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4"
        }
      }
    },
    "anthropic": {},
    "opencode-go": {}
  }
}
