{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "prompt.editor": "<leader>o",
    "session.page.up": "pageup,ctrl+b",
    "session.page.down": "pagedown,ctrl+f"
  },
  "plugins": [
    "@slkiser/opencode-quota@4.10.6",
    "@cortexkit/opencode-magic-context@0.44.4"
  ],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "editor": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
