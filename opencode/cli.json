{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "keybinds": {
    "prompt.editor": "<leader>o",
    "session.page.up": "pageup,ctrl+b",
    "session.page.down": "pagedown,ctrl+f",
    "agent.cycle": "tab",
    "session.background": "<leader>b",
    "session.sidebar.toggle": false
  },
  "plugins": [
    "-opencode.sidebar.context",
    "-opencode.sidebar.mcp",
    "-opencode.prompt.footer",
    "@slkiser/opencode-quota@6.0.0",
    "@cortexkit/opencode-magic-context@0.49.12",
    "./tui-plugins/mcp-sidebar",
    "./tui-plugins/pr-sidebar"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "terminal": {
    "title": false,
    "copy": "select"
  },
  "prompt": {
    "editor": true,
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "mini": {
    "mono": false,
    "work_spinner": "block-soft-sweep",
    "splash": "show",
    "footer": "show",
    "thinking": "hide",
    "tools": "hide",
    "shell_output": "hide",
    "turn_summary": "show"
  }
}
