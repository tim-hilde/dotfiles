{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "prompt.editor": "<leader>o",
    "session.page.up": "pageup,ctrl+b",
    "session.page.down": "pagedown,ctrl+f",
    "agent.cycle": "tab"
  },
  "plugins": [
    "@slkiser/opencode-quota@5.0.1",
    "@cortexkit/opencode-magic-context@0.45.0"
  ],
  "diffs": {
    "wrap": "word"
  },
  "compaction": {
    "auto": false
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "editor": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
