{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "keybinds": {
    "prompt.editor": "<leader>o",
    "session.page.up": "pageup,ctrl+b",
    "session.page.down": "pagedown,ctrl+f",
    "agent.cycle": "tab",
    "session.background": "<leader>b"
  },
  "plugins": [
    "-opencode.sidebar.context",
    "-opencode.sidebar.mcp",
    "@slkiser/opencode-quota@5.0.1",
    "@cortexkit/opencode-magic-context@0.45.0",
    "./tui-plugins/mcp-sidebar"
  ],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "editor": true,
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "mini": {
    "mono": false,
    "work_spinner": "block-soft-sweep",
    "splash": "show",
    "footer": "show"
  }
}
