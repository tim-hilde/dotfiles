// Shared preferences for OpenCode TUI plugins.
// One top-level key per plugin (short name). See each plugin's README for its
// supported settings. This file is safe to hand-edit; plugins update individual
// keys and preserve the rest (values and comments).
{
  "magic-context": {
    "toast_duration_ms": 0,
    "collapsed": true,
    "sections": {
      "historian": false,
      "memory": false,
      "status": false,
      "dreamer": false,
      "stats": false
    }
  },
   "anthropic-auth": {
    "forceToTop": false,
    "order": 160,
    "startCollapsed": false,
    "rememberCollapsed": true,
    "pollMs": 1500,
    "refreshDebounceMs": 200,
    "header": { "label": "CLAUDE", "showVersion": true },
    "sections": {
      "quota": false,
      "fallbackAccounts": false,
      "routing": false,
      "cache": false,
      "health": false,
      "pacing": false
    },
    "collapsed": false
  }
}
