# Pi Agent: always start in Plan mode (@narumitw/pi-plan-mode)
# Use `command pi` to bypass and start without Plan mode.
function pi() {
    command pi --plan "$@"
}

function _wt_prune_size() {
  local LC_ALL=C
  if (( $1 < 1024 )); then
    print "${1}K"
  elif (( $1 < 1048576 )); then
    printf '%.1fM\n' $(( $1 / 1024.0 ))
  else
    printf '%.1fG\n' $(( $1 / 1048576.0 ))
  fi
}

function _wt_prune_age() {
  local -i s=$1 n
  local -a unit
  if (( s < 60 )); then
    print "gerade eben"
    return
  elif (( s < 3600 )); then
    n=s/60; unit=(Minute Minuten)
  elif (( s < 86400 )); then
    n=s/3600; unit=(Stunde Stunden)
  elif (( s < 1209600 )); then
    n=s/86400; unit=(Tag Tagen)
  elif (( s < 6048000 )); then
    n=s/604800; unit=(Woche Wochen)
  else
    n=s/2592000; unit=(Monat Monaten)
  fi
  print "vor $n ${unit[n == 1 ? 1 : 2]}"
}

function _wt_prune_changes() {
  local st line
  st=$(git -C $1 status --porcelain 2>/dev/null) || return 1
  for line in ${(f)st}; do
    case $line in
      ('?? .infisical.yaml'|' M next-env.d.ts'|' M package-lock.json'|'?? AGENTS.md'|'?? '*node_modules|'?? '*node_modules/) ;;
      (*) print -r -- $line ;;
    esac
  done
}

function _wt_prune_base() {
  local b
  for b in $2 staging dev main; do
    git -C $1 rev-parse -q --verify refs/remotes/origin/$b >/dev/null && { print origin/$b; return 0 }
  done
  return 1
}

function _wt_prune_select() {
  local answer=$1 tok
  local -i count=$2 a b i
  shift 2
  local -a safe=($@) picked
  for tok in ${(s:,:)${answer// /,}}; do
    case $tok in
      (s) picked+=($safe) ;;
      (<->)
        (( tok >= 1 && tok <= count )) || return 1
        picked+=($tok) ;;
      (<->-<->)
        a=${tok%-*}
        b=${tok#*-}
        (( a >= 1 && a <= b && b <= count )) || return 1
        for (( i = a; i <= b; i++ )); do picked+=($i); done ;;
      (*) return 1 ;;
    esac
  done
  print -- ${(nu)picked}
}

# Show all worktrees under the root in numbered groups with their sizes and ask which ones to delete.
# With --yes, delete the group "Sicher löschbar" without the prompt.
function wt-prune() {
  local root arg
  local -i yes=0
  for arg; do
    if [[ $arg == --yes ]]; then
      yes=1
    elif [[ $arg == -* || -n $root ]]; then
      print -u2 "Aufruf: wt-prune [--yes] [Ordner]"
      return 2
    else
      root=$arg
    fi
  done
  root=${${root:-$HOME/code/merlin/worktrees}:A}

  local gitfile wt rel main branch slug out line base cherry changes prnote answer d sha name
  local -i g i j n gi gc gk total ahead localonly nchanges ghfail now kb nobase
  local -a wts prs parts chg plus notes others files safe_idx sel risky logl
  local -aU repos
  local -a u_rels u_mains u_branches u_groups u_kbs u_locals u_changes u_texts o_idx
  local -a groups=("Sicher löschbar" "Ohne eigene Arbeit" "PR offen" "Eigene Commits" "Nicht committete Änderungen")

  for gitfile in $root/{*,*/*,*/*/*}/.git(N.); do
    [[ $(<$gitfile) == *"/.git/worktrees/"* ]] && wts+=${gitfile:h}
  done
  if (( ! $#wts )); then
    print "Keine Worktrees in $root."
    return 0
  fi
  print -u2 "Prüfe $#wts Worktrees …"
  for wt in $wts; do
    main=$(git -C $wt rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && repos+=${main:h}
  done
  for main in $repos; do
    git -C $main fetch --quiet --prune origin >/dev/null 2>&1 ||
      print -u2 "fetch fehlgeschlagen bei ${main:t}, Stand kann veraltet sein"
  done
  now=$(date +%s)

  for wt in $wts; do
    rel=${wt#$root/}
    if ! changes=$(_wt_prune_changes $wt); then
      print -u2 "git-Fehler bei $rel, übersprungen"
      continue
    fi
    chg=(${(f)changes})
    nchanges=$#chg
    main=${$(git -C $wt rev-parse --path-format=absolute --git-common-dir):h}
    branch=$(git -C $wt branch --show-current)
    localonly=$(git -C $wt rev-list --count HEAD --not --remotes)

    prs=()
    ghfail=0
    if [[ -n $branch ]]; then
      slug=$(git -C $main config --get remote.origin.url)
      slug=${${slug%.git}#*github.com[:/]}
      if out=$(gh pr list --repo $slug --head $branch --state all \
          --json number,state,baseRefName,headRefOid \
          --jq '.[] | "\(.number) \(.state) \(.baseRefName) \(.headRefOid)"' </dev/null 2>/dev/null); then
        prs=(${(f)out})
      else
        ghfail=1
      fi
    fi

    g=0
    prnote=""
    for line in $prs; do
      parts=(${=line})
      [[ $parts[2] == OPEN ]] && { g=3; prnote="PR #$parts[1] offen"; break }
    done
    if (( ! g && ! nchanges )); then
      for line in $prs; do
        parts=(${=line})
        [[ $parts[2] == (MERGED|CLOSED) ]] || continue
        git -C $wt cat-file -e "$parts[4]^{commit}" 2>/dev/null || continue
        base=$(_wt_prune_base $wt $parts[3]) || continue
        cherry=$(git -C $wt cherry $base HEAD $parts[4] 2>/dev/null) || continue
        [[ $cherry == *+* ]] && continue
        g=1
        if [[ $parts[2] == MERGED ]]; then
          prnote="PR #$parts[1] gemergt"
        else
          prnote="PR #$parts[1] geschlossen"
        fi
        break
      done
    fi

    ahead=0
    nobase=0
    if (( g != 1 )) && ! base=$(_wt_prune_base $wt ""); then
      nobase=1
    elif (( g != 1 )); then
      plus=(${(M)${(f)"$(git -C $wt cherry $base HEAD 2>/dev/null)"}:#+*})
      ahead=$#plus
      if (( ahead )) && out=$(git -C $wt merge-tree --write-tree $base HEAD 2>/dev/null) &&
          [[ ${out%%$'\n'*} == $(git -C $wt rev-parse "$base^{tree}") ]]; then
        ahead=0
      fi
    fi
    if (( ! g )); then
      if (( nchanges )); then
        g=5
      elif (( ahead || nobase )); then
        g=4
      else
        g=2
      fi
    fi
    if [[ -z $prnote && -n $prs[1] ]]; then
      parts=(${=prs[1]})
      case $parts[2] in
        (MERGED) prnote="PR #$parts[1] gemergt" ;;
        (CLOSED) prnote="PR #$parts[1] geschlossen" ;;
        (*) prnote="PR #$parts[1] offen" ;;
      esac
    fi

    out=$(du -sk $wt 2>/dev/null)
    kb=${out%%[[:space:]]*}
    notes=(${main:t})
    [[ -n $prnote ]] && notes+=$prnote
    [[ -z $branch ]] && notes+=detached
    if (( g != 1 )); then
      (( ahead == 1 )) && notes+="1 Commit"
      (( ahead > 1 )) && notes+="$ahead Commits"
      (( localonly )) && notes+="$localonly nur lokal"
      (( nchanges == 1 )) && notes+="1 Änderung"
      (( nchanges > 1 )) && notes+="$nchanges Änderungen"
    fi
    (( nobase )) && notes+="Basis unbekannt"
    (( ghfail )) && notes+="PR-Status unbekannt"
    notes+=$(_wt_prune_size $kb)
    notes+=$(_wt_prune_age $(( now - $(git -C $wt log -1 --format=%ct) )))

    u_rels+=("$rel")
    u_mains+=("$main")
    u_branches+=("$branch")
    u_groups+=($g)
    u_kbs+=($kb)
    u_locals+=($localonly)
    u_changes+=($nchanges)
    u_texts+=("${(j:, :)notes}")
  done

  for (( gi = 1; gi <= 5; gi++ )); do
    gc=0
    gk=0
    for (( i = 1; i <= $#u_rels; i++ )); do
      (( u_groups[i] == gi )) && (( gc += 1, gk += u_kbs[i] ))
    done
    (( gc )) || continue
    print "$groups[gi] ($gc, $(_wt_prune_size $gk))"
    for (( i = 1; i <= $#u_rels; i++ )); do
      (( u_groups[i] == gi )) || continue
      (( n += 1 ))
      o_idx+=($i)
      printf '%4d  %s  (%s)\n' $n "$u_rels[i]" "$u_texts[i]"
    done
    (( total += gk ))
  done
  print "Gesamt: $n Worktrees, $(_wt_prune_size $total)"

  for d in $root/*(/N) $root/*/*(/N); do
    [[ -e $d/.git ]] && continue
    [[ ${d:h} != $root && -e ${d:h}/.git ]] && continue
    (( ${wts[(I)$d/*]} )) && continue
    [[ ${d:h} != $root ]] && (( ! ${wts[(I)${d:h}/*]} )) && continue
    files=($d/**/*(.DN))
    files=(${files:#*/.DS_Store})
    case $#files in
      (0) others+="${d#$root/} (leer)" ;;
      (1) others+="${d#$root/} (1 Datei)" ;;
      (*) others+="${d#$root/} ($#files Dateien)" ;;
    esac
  done
  (( $#others )) && print "Andere Ordner: ${(j:, :)others}"

  for (( i = 1; i <= $#o_idx; i++ )); do
    (( u_groups[o_idx[i]] == 1 )) && safe_idx+=($i)
  done

  if (( yes )); then
    if (( ! $#safe_idx )); then
      print "Keine sicher löschbaren Worktrees."
      return 0
    fi
    sel=($safe_idx)
    gk=0
    for i in $sel; do
      (( gk += u_kbs[o_idx[i]] ))
    done
    print "Lösche alle $#sel sicheren Worktrees (insgesamt $(_wt_prune_size $gk))."
  else
    print -n "Welche löschen? Nummern oder Bereiche wie 3-9, s für alle sicheren, Enter für keine: "
    read answer
    if ! out=$(_wt_prune_select "$answer" $n $safe_idx); then
      print "Ungültige Eingabe \"$answer\". Erlaubt sind Nummern, Bereiche wie 3-9 und s. Nichts gelöscht."
      return 1
    fi
    sel=(${=out})
    if (( ! $#sel )); then
      print "Abgebrochen, nichts gelöscht."
      return 0
    fi

    for i in $sel; do
      j=$o_idx[i]
      (( u_groups[j] != 1 && (u_locals[j] || u_changes[j]) )) && risky+=($i)
    done
    if (( $#risky )); then
      print "Diese Worktrees enthalten Arbeit, die nur hier liegt:"
      for i in $risky; do
        j=$o_idx[i]
        wt=$root/$u_rels[j]
        notes=()
        (( u_locals[j] == 1 )) && notes+="1 Commit nur lokal"
        (( u_locals[j] > 1 )) && notes+="$u_locals[j] Commits nur lokal"
        (( u_changes[j] == 1 )) && notes+="1 Änderung"
        (( u_changes[j] > 1 )) && notes+="$u_changes[j] Änderungen"
        printf '%4d  %s: %s\n' $i "$u_rels[j]" "${(j:, :)notes}"
        logl=(${(f)"$(git -C $wt log --format='%h %s' HEAD --not --remotes -3)"})
        chg=(${(f)"$(_wt_prune_changes $wt)"})
        for line in $logl $chg[1,3]; do
          print -r -- "      $line"
        done
      done
      print -n "Trotzdem löschen? [y/N] "
      read answer
      if [[ $answer != [yY] ]]; then
        print "Abgebrochen, nichts gelöscht."
        return 0
      fi
    fi
  fi

  for i in $sel; do
    j=$o_idx[i]
    wt=$root/$u_rels[j]
    main=$u_mains[j]
    sha=$(git -C $wt rev-parse --short=12 HEAD)
    if ! out=$(git -C $main worktree remove --force $wt 2>&1); then
      print -u2 "Fehler: $u_rels[j]: $out"
      continue
    fi
    if [[ -n $u_branches[j] ]]; then
      git -C $main branch -D $u_branches[j] >/dev/null 2>&1 || print -u2 "Branch $u_branches[j] nicht gelöscht"
    fi
    git -C $main worktree prune
    print "gelöscht: $u_rels[j]"
    if (( u_locals[j] )); then
      name=${u_branches[j]:-${u_rels[j]:t}}
      print "  wiederherstellen: git -C $main branch $name $sha"
    fi

    d=${wt:h}
    while [[ $d != $root ]]; do
      files=($d/*(DN))
      (( ${#${files:#*/.DS_Store}} )) && break
      rm -f $d/.DS_Store
      rmdir $d || break
      d=${d:h}
    done
  done
}

